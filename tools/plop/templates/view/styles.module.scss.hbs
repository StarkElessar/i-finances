.page {
    display: grid;
    gap: var(--space-8);
    align-content: start;

    inline-size: 100%;
    padding-block: var(--space-8);
}

.header {
    display: grid;
    gap: var(--space-3);
}

.title {
    margin: 0;

    font-size: var(--font-size-heading-1);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-heading);
    color: var(--color-text-primary);
}
