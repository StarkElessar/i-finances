# API password sign-in limits. Package commands load ../../.env, so copy these settings to the root .env.
# The complete application environment template is ../../.env.example.

# Concurrent public password verifications per process (1-8), including dummy Argon2 checks.
PASSWORD_VERIFY_MAX_CONCURRENT=8
# FIFO waiting requests (0-64); 0 disables the queue.
PASSWORD_VERIFY_MAX_QUEUE=64
# Maximum queue wait (1-10000 ms). A running verification is never released by this timeout.
PASSWORD_VERIFY_QUEUE_TIMEOUT_MS=2000
# Maximum retained keys in each login counter: pair, username and IPv4 address / IPv6 /64 (1-100000).
LOGIN_RATE_LIMIT_MAX_KEYS=10000
