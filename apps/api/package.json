{
	"name": "@i-finances/api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "pnpm run typecheck",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx scripts/migrate-db.ts",
		"dev": "pnpm run db:migrate && tsx watch src/main.ts",
		"start": "tsx src/main.ts",
		"test": "vitest run",
		"typecheck": "node ./node_modules/typescript7/bin/tsc -p tsconfig.json"
	},
	"dependencies": {
		"@hono/node-server": "^1.19.0",
		"@i-finances/contracts": "workspace:*",
		"@node-rs/argon2": "^2.0.2",
		"@simplewebauthn/server": "^13.3.2",
		"better-sqlite3": "^12.11.1",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.9.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^26.1.1",
		"drizzle-kit": "^0.31.10",
		"tsx": "^4.23.1",
		"typescript7": "npm:typescript@7.0.2",
		"vitest": "^4.1.10"
	}
}
