{
	"name": "i-finances",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "pnpm run typecheck && vite build",
		"start": "vite start",
		"preview": "vite preview",
		"typecheck": "node ./node_modules/typescript7/bin/tsc -p tsconfig.json",
		"lint:fix": "pnpm run lint:js:fix && pnpm run lint:css:fix",
		"lint:js:fix": "eslint \"src/**/*.{js,ts,jsx,tsx}\" --fix",
		"lint:css:fix": "stylelint \"**/*.scss\" --allow-empty-input --fix"
	},
	"dependencies": {
		"@solidjs/meta": "^0.29.4",
		"@solidjs/router": "^0.15.0",
		"@solidjs/start": "2.0.0-alpha.3",
		"@solidjs/vite-plugin-nitro-2": "^0.3.0",
		"solid-js": "^1.9.5",
		"vite": "^8.1.4"
	},
	"engines": {
		"node": ">=22"
	},
	"devDependencies": {
		"@eslint/js": "^9.0.8",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@stylistic/stylelint-config": "^5.0.0",
		"@stylistic/stylelint-plugin": "^5.2.1",
		"@types/node": "^26.1.1",
		"eslint": "^9.0.0",
		"eslint-plugin-simple-import-sort": "^13.0.0",
		"globals": "^17.7.0",
		"lint-staged": "^17.0.8",
		"postcss-scss": "^4.0.9",
		"postcss-sort-media-queries": "^6.6.2",
		"sass-embedded": "^1.100.0",
		"stylelint": "^17.14.0",
		"stylelint-config-clean-order": "^10.0.0",
		"stylelint-config-standard-scss": "^17.0.0",
		"stylelint-order": "^8.1.1",
		"stylelint-scss": "^7.2.0",
		"stylelint-use-logical": "^2.1.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.63.0",
		"typescript7": "npm:typescript@7.0.2"
	}
}
