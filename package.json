{
	"name": "i-finances-workspace",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "pnpm --parallel --filter @i-finances/api --filter @i-finances/web dev",
		"build": "pnpm --filter @i-finances/contracts build && pnpm --filter @i-finances/api build && pnpm --filter @i-finances/web build",
		"test": "pnpm --filter @i-finances/api test",
		"typecheck": "pnpm --filter @i-finances/contracts typecheck && pnpm --filter @i-finances/api typecheck && pnpm --filter @i-finances/web typecheck",
		"lint": "eslint \"apps/**/*.{js,ts,tsx}\" \"packages/**/*.{js,ts,tsx}\" --max-warnings 0 && stylelint \"apps/**/*.scss\" --allow-empty-input",
		"lint:fix": "eslint \"apps/**/*.{js,ts,tsx}\" \"packages/**/*.{js,ts,tsx}\" --fix && stylelint \"apps/**/*.scss\" --allow-empty-input --fix",
		"db:migrate": "pnpm --filter @i-finances/api db:migrate"
	},
	"engines": {
		"node": ">=22"
	},
	"devDependencies": {
		"@stark/eslint-config": "git+ssh://git@github.com/StarkElessar/stark-eslint-config.git#v0.1.0",
		"@stark/stylelint-config": "git+ssh://git@github.com/StarkElessar/stark-stylelint-config.git#v0.1.0",
		"eslint": "^9.0.0",
		"globals": "^17.7.0",
		"postcss-sort-media-queries": "^6.6.2",
		"sass-embedded": "^1.100.0",
		"stylelint": "^17.14.0",
		"typescript-eslint": "^8.63.0"
	},
	"packageManager": "pnpm@11.12.0+sha512.820a6fbd0d9f04c226638002aead1e45340a9139dd5dc077c1d83ef44aa2481c8eb6637b4c9aa696a3c7e35ba818e49cf27213e5f2b91138d09b7a3e26e898ba"
}
