API_PORT=3001
WEB_PORT=5173

# Paths are resolved from apps/api when API scripts are run through its package commands.
DATABASE_URL=./data/i-finances.sqlite
SESSION_COOKIE_NAME=i_finances_session
SESSION_TTL_DAYS=30
AUTH_ORIGIN=http://localhost:5173
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=iFinances
RECEIPT_IMAGE_ROOT=./storage/receipts
RECEIPT_IMAGE_RETENTION_DAYS=5

# Receipt worker runs as a separate process against the API above.
RECEIPT_WORKER_API_KEY=
RECEIPT_WORKER_BASE_URL=http://localhost:3001
RECEIPT_WORKER_ID=claude-pro-worker
RECEIPT_WORKER_POLL_INTERVAL_MS=30000
RECEIPT_WORKER_HEARTBEAT_INTERVAL_MS=180000
RECEIPT_WORKER_CLAUDE_TIMEOUT_MS=240000
RECEIPT_WORKER_CLAUDE_MODEL=

SEED_USERNAME=
SEED_PASSWORD=
SEED_DISPLAY_NAME=
SEED_HOUSEHOLD_ID=default-household
SEED_HOUSEHOLD_NAME=Семья
