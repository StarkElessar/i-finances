API_PORT=3001
WEB_PORT=5173

# Paths are resolved from apps/api when API scripts are run through its package commands.
DATABASE_URL=./data/i-finances.sqlite
SESSION_COOKIE_NAME=i_finances_session
SESSION_TTL_DAYS=30
AUTH_ORIGIN=http://localhost:5173
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=iFinances
RECEIPT_IMAGE_ROOT=./storage/receipts
RECEIPT_IMAGE_RETENTION_DAYS=5

# Receipt processing runs in-process inside the API, calling the
# corporate LiteLLM proxy directly. Leave RECEIPT_LITELLM_API_KEY empty
# to disable receipt processing entirely (the API still serves normally).
RECEIPT_LITELLM_BASE_URL=https://litellm.holdingbp.ru:4000/v1
RECEIPT_LITELLM_API_KEY=
RECEIPT_LITELLM_OCR_MODEL=deepseek-v4-flash-vision-exp
RECEIPT_LITELLM_CATEGORIZATION_MODEL=deepseek-v4-flash
RECEIPT_PROCESSING_POLL_INTERVAL_MS=5000
RECEIPT_PROCESSING_TIMEOUT_MS=120000

# MCP server runs as a separate process against the API above, authenticating
# as the household user below instead of a browser session.
MCP_API_KEY=
MCP_USER_ID=
MCP_BASE_URL=http://localhost:3001

SEED_USERNAME=
SEED_PASSWORD=
SEED_DISPLAY_NAME=
SEED_HOUSEHOLD_ID=default-household
SEED_HOUSEHOLD_NAME=Семья
