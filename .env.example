DATABASE_URL=./data/i-finances.sqlite
SESSION_COOKIE_NAME=i_finances_session
SESSION_TTL_DAYS=30
AUTH_ORIGIN=http://localhost:5173
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=iFinances
RECEIPT_IMAGE_ROOT=./static/receipts
# Generate with `pnpm receipt:worker-key` and keep outside version control.
RECEIPT_WORKER_API_KEY=
# Days after approval before a receipt photo is eligible for cleanup.
RECEIPT_IMAGE_RETENTION_DAYS=5

# Used only by `pnpm receipt:claude-worker` (requires `claude` CLI logged in
# with a Claude Pro/Max subscription on this machine).
RECEIPT_WORKER_BASE_URL=http://localhost:5173
RECEIPT_WORKER_ID=claude-pro-worker
RECEIPT_WORKER_POLL_INTERVAL_MS=30000
# Pause after each processed job, even on failure, before leasing the next
# one. Without this, a queue of several receipts fires `claude -p` back-to-
# back and trips the Claude Pro/Max subscription's rate limiting.
RECEIPT_WORKER_JOB_COOLDOWN_MS=15000
RECEIPT_WORKER_HEARTBEAT_INTERVAL_MS=180000
RECEIPT_WORKER_CLAUDE_TIMEOUT_MS=240000
# Optional: pin a specific model instead of the CLI's configured default.
RECEIPT_WORKER_CLAUDE_MODEL=

# Used only by `pnpm db:seed`.
SEED_USERNAME=
SEED_PASSWORD=
SEED_DISPLAY_NAME=
SEED_HOUSEHOLD_ID=default-household
SEED_HOUSEHOLD_NAME=Семья
