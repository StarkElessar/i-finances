API_PORT=3001
WEB_PORT=5173

# Paths are resolved from apps/api when API scripts are run through its package commands.
DATABASE_URL=./data/i-finances.sqlite
SESSION_COOKIE_NAME=i_finances_session
SESSION_TTL_DAYS=30
AUTH_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of the API that append to X-Forwarded-For (0-10).
# 0 trusts no forwarding header (local development). Production behind the homelab nginx: 1.
# With NODE_ENV=production the API refuses to start when this is not set explicitly.
TRUSTED_PROXY_COUNT=0
# Public password sign-in only: at most 8 running verifications and 64 waiting requests per API process.
PASSWORD_VERIFY_MAX_CONCURRENT=8
PASSWORD_VERIFY_MAX_QUEUE=64
# Queue deadline (1-10000 ms); overload returns 429 rate-limited, Retry-After = ceil(timeout / 1000).
PASSWORD_VERIFY_QUEUE_TIMEOUT_MS=2000
# Retained keys in EACH password-login counter (1-100000); oldest active window is evicted if all are active.
LOGIN_RATE_LIMIT_MAX_KEYS=10000
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=iFinances
# How long a household invitation link lives, in whole hours (1-168). Empty means 168 (7 days).
HOUSEHOLD_INVITATION_TTL_HOURS=
# Platform administrators: logins (users.username) separated by commas, e.g. stark. Only they create invitations into
# the application (a person who holds one signs up through Telegram while registration is closed and founds their own
# household). Empty means nobody. Never a display name. See development/decisions/app-invitations-v1.md.
PLATFORM_ADMIN_USERNAMES=
# How long an invitation into the application lives, in whole hours (1-168). Empty means 168 (7 days).
APP_INVITATION_TTL_HOURS=

# Telegram bot (sign-in and notifications; see development/decisions/telegram-auth-and-households-v1.md, Р12).
# Leave TELEGRAM_UPDATES=off (the default) to run without a bot. Any other mode needs the token and the username.
# The token and the webhook secret are secrets: keep them only in the server env and in your local .env, never in git.
# Use a dedicated bot per environment: a bot has a single updates consumer. Production runs a webhook; polling with the
# production token only gets 409 (it never deletes a webhook), but any message the local API sends reaches real chats.
TELEGRAM_BOT_TOKEN=
# Bot name without "@", used for https://t.me/<name> links.
TELEGRAM_BOT_USERNAME=
# webhook (production) | polling (local, with a dev bot) | off (tests, default)
TELEGRAM_UPDATES=off
# webhook mode only: 1-256 characters of A-Z a-z 0-9 _ - (at least 32 in production), sent by Telegram in the
# X-Telegram-Bot-Api-Secret-Token header. Generate one with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# webhook mode only: defaults to ${AUTH_ORIGIN}/api/telegram/webhook (https is required in production).
TELEGRAM_WEBHOOK_URL=
# How long a Telegram sign-in or link request lives, in whole minutes (1-60). Empty means 10.
TELEGRAM_LOGIN_TTL_MINUTES=
# false (default): only users who already linked Telegram can sign in with it, an unknown Telegram account is refused
# unless the person came with a live invitation link (into a household or into the application).
# true: any unknown Telegram account creates a new user. The owner's decision of 2026-10-22 keeps it false: new people
# come only by invitation (development/decisions/app-invitations-v1.md).
TELEGRAM_REGISTRATION_ENABLED=false
# Local development without a bot: true enables POST /api/dev/telegram/confirm, which confirms a sign-in or link
# request for ANY Telegram id, that is, it signs in as any user of the database. The API refuses to start with it in
# production and answers it only to this machine (loopback peer; 404 for everyone else). NEVER enable it over a copy
# of the production database or on a stand reachable by others: use it only with a disposable local database.
# The loopback check sees the TCP peer only: anything that proxies to the API from this machine (the Vite dev server,
# a local nginx) makes every request local. With `vite --host` the whole network gets the route through the proxy.
# Production refuses the flag, and behind nginx it must stay off anyway.
DEV_TELEGRAM_LOGIN=false

RECEIPT_IMAGE_ROOT=./storage/receipts
RECEIPT_IMAGE_RETENTION_DAYS=5

# Receipt processing runs in-process inside the API, calling the
# corporate LiteLLM proxy directly. Leave RECEIPT_LITELLM_API_KEY empty
# to disable receipt processing entirely (the API still serves normally).
RECEIPT_LITELLM_BASE_URL=https://litellm.holdingbp.ru:4000/v1
RECEIPT_LITELLM_API_KEY=
RECEIPT_LITELLM_MODEL=deepseek-flash
RECEIPT_PROCESSING_POLL_INTERVAL_MS=5000
RECEIPT_PROCESSING_TIMEOUT_MS=120000

# MCP server runs as a separate process against the API above, authenticating
# as the household user below instead of a browser session. MCP_USER_ID must be a member of a household, and in
# production the owner of it (the id of the household owner): without membership MCP gets 403 household-required.
MCP_API_KEY=
MCP_USER_ID=
MCP_BASE_URL=http://localhost:3001

SEED_USERNAME=
SEED_PASSWORD=
SEED_DISPLAY_NAME=
SEED_HOUSEHOLD_ID=default-household
SEED_HOUSEHOLD_NAME=Семья
